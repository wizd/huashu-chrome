{
  "name": "eda",
  "title": "嘉立创EDA 专业版",
  "description": "在嘉立创EDA/EasyEDA 专业版网页编辑器里调用有类型、带核对的原理图与 PCB 操作（来自 easyeda-agent 的 actions 层）。",
  "hosts": ["pro.lceda.cn", "pro.easyeda.com"],
  "waitFor": "_EXTAPI_ROOT_",
  "files": ["agent.js"],
  "limits": { "payloadMax": 262144, "timeoutMs": 120000, "timeoutMaxMs": 600000 },
  "vendor": {
    "name": "easyeda-agent",
    "repo": "https://github.com/zhoushoujianwork/easyeda-agent.git",
    "commit": "7a73a6834d8d76fd9765dd06f9d4e4bdd6b0556a",
    "version": "1.15.0",
    "entry": "extension/src/actions.ts",
    "license": "MIT AND Apache-2.0"
  },
  "actions": {
    "read": [
      "project.current", "project.find",
      "document.current", "document.source.get", "document.open", "document.close",
      "editor.panels", "view.fit", "view.zoom", "view.region",
      "board.list", "board.current",
      "schematic.pages.list", "schematic.page.open", "schematic.titleblock.get",
      "schematic.components.list", "schematic.attribute.inspect", "schematic.designators.list",
      "schematic.image.list", "schematic.text.list", "schematic.visible_text.bboxes",
      "schematic.read", "schematic.drc.check", "schematic.check", "schematic.bridgeCheck",
      "schematic.export.netlist", "schematic.export.image", "schematic.export.bom",
      "schematic.library.search", "schematic.library.get_by_lcsc",
      "library.list", "library.common.list", "library.footprint.get", "library.symbol.get",
      "library.symbol.export_source", "library.device.get",
      "pcb.documents.list", "pcb.board.info", "pcb.components.list", "pcb.layers.list",
      "pcb.layers.set_current", "pcb.layers.visibility", "pcb.view.side", "pcb.view.filter.get",
      "pcb.silk.list", "pcb.image.list", "pcb.nets.list", "pcb.net_class.list", "pcb.constraint.list",
      "pcb.report", "pcb.drc.check", "pcb.drc.rules", "pcb.config.get",
      "pcb.line.list", "pcb.via.list", "pcb.pour.list", "pcb.poured.list", "pcb.region.list", "pcb.fill.list",
      "pcb.outline.get", "pcb.origin.get", "pcb.snapshot", "pcb.export.dsn"
    ],
    "write": [
      "project.create", "project.open",
      "board.create", "board.new", "board.new_pcb", "board.rename", "board.copy", "board.rebind",
      "schematic.rename", "schematic.page.create", "schematic.page.rename", "schematic.titleblock.modify",
      "schematic.component.place", "schematic.component.modify", "schematic.component.delete",
      "schematic.component.replace", "schematic.component.resolve_lcsc",
      "schematic.rebind.footprint", "schematic.rebind.symbol",
      "schematic.attribute.move", "schematic.text.move", "schematic.group.move", "schematic.primitives.delete",
      "schematic.wire.create", "schematic.netflag.create", "schematic.power.connect_pin",
      "schematic.pin.set_no_connect", "schematic.pin.disconnect",
      "schematic.image.create", "schematic.image.modify", "schematic.save",
      "library.footprint.create", "library.footprint.copy", "library.footprint.build", "library.footprint.region_create",
      "library.symbol.create", "library.symbol.build", "library.device.create",
      "pcb.import_changes", "pcb.add_component", "pcb.component.attrs_backfill",
      "pcb.component.modify", "pcb.component.lock", "pcb.component.delete",
      "pcb.components.move", "pcb.components.arrange", "pcb.align", "pcb.distribute", "pcb.grid_snap",
      "pcb.stackup.set", "pcb.drc.rules.set", "pcb.config.set", "pcb.net.color.set",
      "pcb.net_class.create", "pcb.differential_pair.create", "pcb.differential_pair.delete",
      "pcb.differential_pair.rename", "pcb.equal_length_group.create", "pcb.equal_length_group.add_nets",
      "pcb.equal_length_group.delete",
      "pcb.outline.set", "pcb.outline.clear", "pcb.origin.set",
      "pcb.line.create", "pcb.via.create", "pcb.route.rip_up", "pcb.route.delete", "pcb.route.via_hop",
      "pcb.track.lock", "pcb.clear_routing", "pcb.route.auto", "pcb.import_autoroute",
      "pcb.pour.create", "pcb.pour.delete", "pcb.pour.rebuild",
      "pcb.region.create", "pcb.region.delete", "pcb.fill.create", "pcb.fill.delete",
      "pcb.silk.add", "pcb.silk.set", "pcb.silk.align", "pcb.silk.netnames", "pcb.silk.label_pads",
      "pcb.silk.import_svg", "pcb.image.create", "pcb.image.modify", "pcb.image.delete",
      "pcb.beautify", "pcb.save"
    ]
  },
  "confirm": {
    "schematic.component.delete": "删除原理图里的元件",
    "schematic.primitives.delete": "删除原理图里的图元（导线、标识、文字等）",
    "pcb.import_changes": "把原理图的改动导入 PCB（可能增删封装和飞线）",
    "pcb.add_component": "往 PCB 上加封装",
    "pcb.component.delete": "删除 PCB 上的封装",
    "pcb.outline.set": "重画板框",
    "pcb.outline.clear": "清掉板框",
    "pcb.route.rip_up": "拆掉布线",
    "pcb.route.delete": "删除布线",
    "pcb.clear_routing": "清空全部布线",
    "pcb.route.auto": "自动布线（会整片重做走线）",
    "pcb.pour.delete": "删除铺铜",
    "pcb.region.delete": "删除禁止区域",
    "pcb.fill.delete": "删除填充"
  },
  "denied": {
    "debug.exec_js": "任意 JS，等于放开 eval",
    "system.page_reload": "刷新整个编辑器，会丢掉未保存的修改",
    "system.notify": "往用户屏幕上弹消息",
    "project.export": "依赖桌面客户端的文件接口",
    "project.export_source": "依赖桌面客户端的文件接口",
    "project.import": "依赖桌面客户端的文件接口",
    "document.source.roundtrip": "整份替换文档源码，绕过逐项核对",
    "schematic.page.delete": "删除整页，用户在编辑器里自己做",
    "schematic.page.clear": "清空整页，用户在编辑器里自己做",
    "pcb.page.clear": "清空整块 PCB，用户在编辑器里自己做",
    "pcb.document.delete": "删除 PCB 文档，用户在编辑器里自己做",
    "board.delete": "删除板子，用户在编辑器里自己做",
    "library.footprint.delete": "删除库里的封装，用户在编辑器里自己做",
    "library.symbol.delete": "删除库里的符号，用户在编辑器里自己做",
    "library.device.delete": "删除库里的器件，用户在编辑器里自己做"
  }
}
